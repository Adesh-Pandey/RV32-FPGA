10000293  // 0x00: addi t0, zero, 0x100  (Load GPIO MMIO address)
01F00313  // 0x04: addi t1, zero, 0x1F   (Load binary 11111 for 5 LEDs)
0062A023  // 0x08: sw   t1, 0(t0)        (Write bits to LEDs)
01C9C3B7  // 0x0C: lui  t2, 0x01C9C      (Delay upper 20 bits)
38038393  // 0x10: addi t2, t2, 0x380    (Delay lower 12 bits -> 30,000,000)
FFF38393  // 0x14: addi t2, t2, -1       (Decrement delay counter)
FE039EE3  // 0x18: bne  t2, zero, 0x14   (Loop if counter != 0)
01F34313  // 0x1C: xori t1, t1, 0x1F     (Toggle all 5 LED bits)
FE9FF06F  // 0x20: jal  zero, 0x08       (Jump back to write the new LED state)