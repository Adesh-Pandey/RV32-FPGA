// Rotating-LED test for RV32 on Zybo
// Writes a 5-bit pattern to MMIO address 0x100, delays, rotates left, repeats.
//
// Initial pattern: 10111 (0x17). After each rotate-left:
//   10111 -> 01111 -> 11110 -> 11101 -> 11011 -> back to 10111
//
// Register usage:
//   t0 (x5)  = MMIO LED address (0x100)
//   t1 (x6)  = current 5-bit pattern
//   t2 (x7)  = delay counter
//   t3 (x28) = scratch (pattern << 1)
//   t4 (x29) = scratch (pattern >> 4)

10000293  // 0x00: addi t0, x0, 0x100        (LED MMIO addr)
01700313  // 0x04: addi t1, x0, 0x17         (initial pattern 10111)
00628023  // 0x08: sw   t1, 0(t0)            <-- loop:
03C003B7  // 0x0C: lui  t2, 0x3C00           (delay ~63M iter -> ~2 sec)
FFF38393  // 0x10: addi t2, t2, -1           <-- delay:
FE039EE3  // 0x14: bne  t2, x0, -4           (loop back to delay)
00131E13  // 0x18: slli t3, t1, 1            (rotate part 1: shift left)
00435E93  // 0x1C: srli t4, t1, 4            (rotate part 2: extract bit 4)
01DE6333  // 0x20: or   t1, t3, t4           (combine)
01F37313  // 0x24: andi t1, t1, 0x1F         (mask to 5 bits)
FE1FF06F  // 0x28: jal  x0, -0x20            (jump back to loop)
